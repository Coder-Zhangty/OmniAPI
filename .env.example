COMPOSE_PROJECT_NAME=ai-gateway
GATEWAY_PORT=80
# Public deployment sets 0.0.0.0; keep 127.0.0.1 for a local install.
GATEWAY_HOST=127.0.0.1
GATEWAY_PUBLIC_URL=
# Public HTTPS deployments set this after the certificate is issued.
COMPOSE_OVERLAY=
DB_PASSWORD=change_me
REDIS_PASSWORD=change_me
SESSION_SECRET=change_me
CRYPTO_SECRET=change_me
# Exact digests are written by: python scripts/gateway.py lock-images
NEW_API_IMAGE=calciumion/new-api:v1.0.0-rc.40
POSTGRES_IMAGE=postgres:15-alpine
REDIS_IMAGE=redis:7.4-alpine
NGINX_IMAGE=nginx:stable-alpine
PYTHON_IMAGE=python:3.12-alpine
CERTBOT_IMAGE=certbot/certbot:latest
